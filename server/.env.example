# Copy to server/.env and fill in. Never commit the real .env.

# --- Database -----------------------------------------------------------
# Either set DATABASE_URL (managed Postgres: Render, Neon, Railway, ...)
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# On Neon, use the DIRECT endpoint, not the -pooler one. This server keeps its
# own connection pool, so Neon's pgbouncer adds nothing and costs correctness:
# it multiplexes sessions, so a `SET search_path` (or anything else session
# scoped) is not guaranteed to apply to the next query. A pg_dump restore run
# through the pooler leaves `search_path = ''` on a recycled server connection,
# which makes tables appear to vanish. The direct endpoint has none of this.
#   pooled : ep-xxx-pooler.<region>.aws.neon.tech   <- avoid for this app
#   direct : ep-xxx.<region>.aws.neon.tech          <- use this
#
# ALWAYS include the port. This project sets PGPORT=5433 for local Postgres,
# and a URL without a port silently inherits it and times out.
#
# ...or the five separate variables (typical local setup):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=envocab
DB_USER=postgres
DB_PASSWORD=

# SSL: leave unset for auto (on for remote DATABASE_URL, off for local).
# DB_SSL=require

# --- Auth ---------------------------------------------------------------
# Mixed into every password before hashing: bcrypt(password + AUTH_PEPPER).
# It is NOT stored in the database, so it must travel with any copy of the data.
# Restore a database into an environment with a different pepper and every login
# returns 401 despite a correct password. Same for JWT_SECRET and live tokens.
AUTH_PEPPER=some-random-secret-text
BCRYPT_ROUNDS=10
JWT_SECRET=some-random-super-secret-text
JWT_EXPIRES_IN=7d

# --- Server -------------------------------------------------------------
PORT=8000
# Only needed when the frontend is served from a different origin
# (e.g. Vite dev server). Left unset, CORS stays open.
# CLIENT_ORIGIN=http://localhost:5173

# --- Maintainer ---------------------------------------------------------
# Editing a word changes it for every user, so it is restricted to accounts
# with the is_admin flag. The account registering with THIS email gets the flag
# automatically - set it before you sign up on a fresh deployment.
# For an account that already exists: npm run admin -- you@example.com
ADMIN_EMAIL=

# --- Optional tooling ---------------------------------------------------
# Used by other-tools/translate-api.js
DEEPL_API_KEY=
