# Copy to server/.env and fill in. Never commit the real .env.

# --- Database -----------------------------------------------------------
# Either set DATABASE_URL (managed Postgres: Render, Neon, Railway, ...)
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# ...or the five separate variables (typical local setup):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=envocab
DB_USER=postgres
DB_PASSWORD=

# SSL: leave unset for auto (on for remote DATABASE_URL, off for local).
# DB_SSL=require

# --- Auth ---------------------------------------------------------------
AUTH_PEPPER=some-random-secret-text
BCRYPT_ROUNDS=10
JWT_SECRET=some-random-super-secret-text
JWT_EXPIRES_IN=7d

# --- Server -------------------------------------------------------------
PORT=8000
# Only needed when the frontend is served from a different origin
# (e.g. Vite dev server). Left unset, CORS stays open.
# CLIENT_ORIGIN=http://localhost:5173

# --- Optional tooling ---------------------------------------------------
# Used by other-tools/translate-api.js
DEEPL_API_KEY=
